# =====================================================================
# SPORTSYNC ENVIRONMENT VARIABLES (.env.example)
# Copy this file to .env.local for local development
# And paste these keys into Vercel Project Settings > Environment Variables
# =====================================================================

# Supabase Project API URL (Found in Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xyzcompany.supabase.co

# Supabase Anonymous Client Key (Publicly safe key for browser queries)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (Found in Project Settings > API > service_role)
# Keep secret — used server-side only for admin operations
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Session Secret (Used for signing HMAC session cookies)
SESSION_SECRET=sportsync-secure-session-key-2026
